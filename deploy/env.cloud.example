# pi-py cloud deployment environment
# Copy to .env next to docker-compose.cloud.yml and fill in every value.
# chmod 600 .env  — this file holds secrets.

# ---- required: database & cache (Volcano Engine, private network) ----
# Private-network endpoint of the managed MySQL instance, host only (no scheme,
# no port - docker-compose.cloud.yml appends :3306). Use the VPC/private domain,
# NOT the public one: the public endpoint should be switched off entirely.
MYSQL_HOST=change-me

# Password of MySQL user `pi` (grants: DML+DDL on pi_py.* only).
# If it contains URL-special characters (@ : / # ? %), percent-encode them.
MYSQL_PASSWORD=change-me

# Private-network endpoint of the managed Redis instance, host only (no port -
# the compose file appends :6379). Same private-not-public rule as MYSQL_HOST.
REDIS_HOST=change-me

# Password of Redis user `default`. Same URL-encoding rule applies.
REDIS_PASSWORD=change-me

# ---- required: auth ----
# Signs JWTs; must stay stable across restarts or all sessions are invalidated.
# Generate:  openssl rand -hex 32
PI_JWT_SECRET=change-me

# ---- required for real usage: model access ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
PI_MODEL=openai/qwen3.8-max
# PI_FALLBACK_CHAIN=

# ---- optional tuning (defaults for 4 vCPU / 16 GiB) ----
PI_REDIS_NS=prod
PI_MAX_CONCURRENT_RUNS=16
PI_RATE_LIMIT_RUNS_PER_MIN=30
PI_REPLICAS=1

# ---- reverse proxy trust (needed for real client IPs) ----
# Comma-separated IPs or CIDRs allowed to send X-Forwarded-For. Caddy runs in its
# own compose container, so its source IP is in Docker's 172.16/12 space and
# uvicorn's built-in default (127.0.0.1) silently drops the header - every client
# then appears to be Caddy, which makes the audit log's ip field useless and makes
# any IP-based rate limiting lock out the entire world at once.
# NEVER set this to "*": that lets clients spoof XFF and bypass IP limits.
# Running `pi-py serve` with no proxy in front? Leave it commented out.
# PI_FORWARDED_ALLOW_IPS=172.16.0.0/12

# ---- optional: tool-execution isolation ----
# Uncomment ONLY after reading the Sandbox section of deploy/cloud-deploy.md.
# Warm pool is the default when docker mode is on:
#   one warm container per workspace, preheated at turn start, exec per call,
#   idle-recycled after PI_SANDBOX_IDLE_TTL, LRU-capped at PI_SANDBOX_POOL_MAX.
# PI_SANDBOX=docker
# PI_SANDBOX_IMAGE=python:3.12-slim
# PI_SANDBOX_POOL=1              # 0 = legacy fresh-container-per-call
# PI_SANDBOX_POOL_MAX=16
# PI_SANDBOX_IDLE_TTL=600
#
# Per-container ceilings. Docker's own defaults are NO LIMIT (Memory=0, NanoCpus=0,
# no PidsLimit), and registration is open, so an uncapped container lets any account
# exhaust the VM with one command - network isolation does not cover that.
# Both compose files already apply these defaults; uncomment only to tune.
#   sizing: PI_SANDBOX_MEMORY * PI_MAX_CONCURRENT_RUNS must stay well under the VM's
#   RAM, and the warm pool holds up to PI_SANDBOX_POOL_MAX extra idle containers.
# PI_SANDBOX_MEMORY=1g           # also sets an equal --memory-swap, which disables swap
# PI_SANDBOX_PIDS=256            # fork-bomb ceiling; 0 = unlimited
# PI_SANDBOX_CPUS=1.0            # empty = unlimited
# PI_SANDBOX_USER is intentionally absent: it defaults to the app's own uid:gid
# (10001:10001 in the image), so files written through the bind mount stay readable
# and deletable by the app. Setting it to root would leave root-owned files behind
# that the non-root app cannot clean up.

# ---- optional: observability (tracing + metrics) ----
# Execution traces (agent_runs / agent_steps in MySQL) are ALWAYS on and need no
# configuration: every POST /runs records its prompt, model, tokens, duration,
# anomaly flags, and one step row per tool call / memory retrieval / model
# round-trip, with full arguments and results. Read them at
# GET /v1/admin/traces or in the admin UI's 执行轨迹 tab. Retention:
# PI_TRACE_RETENTION_DAYS=30

# Spans. jsonl (the default) writes ~/.pi-py/traces-<date>.jsonl inside the
# container - one trace_id per run, with parent_span_id, so a run can be
# reconstructed as a tree. Switch to otel to export over OTLP/gRPC instead:
#   PI_TRACER=otel
#   PI_OTLP_ENDPOINT=http://jaeger:4317   # the compose service below
# and start a collector:
#   docker compose -f docker-compose.cloud.yml --profile observability up -d
# A missing exporter falls back to jsonl WITH A WARNING, and an unrecognised
# PI_TRACER value means "no tracing" with a warning too - neither is silent.
# PI_TRACER=otel
# PI_OTLP_ENDPOINT=http://jaeger:4317
# PI_TRACE_SAMPLE_RATE=1.0        # sampled once per run, so a tree is never half-kept
# PI_SERVICE_NAME=pi-py
# PI_ENVIRONMENT=prod             # span deployment.environment; set it per install

# /metrics, Prometheus text format. On by default; the compose `observability`
# profile runs a Prometheus that scrapes it (see deploy/prometheus.yml).
# Every series is aggregate - no username, session id or prompt is ever a label -
# but together they describe traffic volume and model mix, and 8300 is published.
# Set a token unless the port is genuinely private: with one set, /metrics
# requires `Authorization: Bearer <token>` and answers 404 (not 403) to a wrong
# one, so a scanner learns nothing. Generate:  openssl rand -hex 24
# PI_METRICS=1
# PI_METRICS_TOKEN=

# Jaeger keeps spans in MEMORY, so bound it; both UIs are unauthenticated and both
# compose files bind their ports to 127.0.0.1 only. Reach them over a tunnel:
#   ssh -L 16686:127.0.0.1:16686 -L 9090:127.0.0.1:9090 <vm>
# PI_JAEGER_MAX_TRACES=20000
# PI_PROMETHEUS_RETENTION=15d

# ---- only if using the tls profile (caddy) ----
# DOMAIN=pi.example.com
