# 本地测试环境变量模板（复制为 .env.local，与生产 .env 严格区分）。
# 用法：先起基础设施 docker compose -f deploy/docker-compose.local.yml up -d，
# 然后：set -a; source .env.local; set +a; pi-py migrate; pi-py serve
# 说明见 deploy/local-dev.md
#
# 本文件是端口配置的**唯一来源**：应用直接读它，compose 经 deploy/.env 软链接读同一份，
# 测试（tests/conftest.py）从下面的 URL 推导。改端口只改本文件。
#   ln -sf ../.env.local deploy/.env        # 让 compose 也读这份
# 若 3306/6379 已被别的服务占用（如与 CubeSandbox 同机），把端口整体上移，见 local-dev.md §2.1

# ---- 基础设施端口（供 compose 端口映射；须与下方 URL 里的端口一致）----
PI_MYSQL_PORT=3306
PI_REDIS_PORT=6379
PI_MILVUS_PORT=19531

# ---- 数据库：本地 MySQL（生产是云端托管 MySQL）----
PI_DATABASE_URL=mysql+aiomysql://pi:pi_py_local@127.0.0.1:3306/pi_py

# ---- 缓存/锁：本地 Redis（生产是云端托管 Redis）----
PI_REDIS_URL=redis://127.0.0.1:6379/0
PI_REDIS_NS=pi-local

# ---- 向量库：本地 Milvus standalone（生产是云端 Milvus）----
PI_MILVUS_URI=http://127.0.0.1:19531

# ---- 模型与 embedding：云 API（本地没有 GPU，与生产共用同一云服务）----
PI_MODEL=openai/qwen3.8-flash
OPENAI_API_KEY=<填生产 .env 里的值>
OPENAI_BASE_URL=<填生产 .env 里的值>
PI_EMBEDDING_URL=<填生产 .env 里的值>
PI_EMBEDDING_API_KEY=<填生产 .env 里的值>
PI_EMBEDDING_MODEL=qwen3.7-text-embedding

# ---- 安全/审计/轨迹（全部指向本地目录，不碰生产文件）----
PI_JWT_SECRET=local-dev-secret
PI_POLICY=/home/zhu/pi-python-20260903/pi-python/policy.json
PI_WORKSPACE_ROOT=/home/zhu/pi-python-20260903/workspaces
PI_AUDIT_PATH=/home/zhu/pi-python-20260903/audit.jsonl
PI_TRAJECTORY_PATH=/home/zhu/pi-python-20260903/trajectories.jsonl

# ---- 沙箱：本地 Docker（与生产一致）----
PI_SANDBOX=docker
PI_SANDBOX_IMAGE=python:3.12-slim

# ---- 可观测 ----
PI_TRACER=jsonl
PI_METRICS=1
PI_METRICS_TOKEN=
