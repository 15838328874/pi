# 本地/裸机服务器环境变量模板（复制为 .env.local，与云部署 .env 严格区分）。
# 本文件与当前服务器的真实 .env.local 形状一致：每个键都列出，密钥用占位符。
# 迁移到新服务器：cp deploy/env.local.example .env.local → 填密钥 → 改路径/端口。
#
# 用法：先起基础设施 docker compose -f deploy/docker-compose.local.yml up -d，
# 然后：set -a; source .env.local; set +a; pi-py migrate; pi-py serve
# 说明见 deploy/local-dev.md；systemd unit 见 /etc/systemd/system/pi-py.service
#
# 本文件是端口配置的**唯一来源**：应用直接读它，compose 经 deploy/.env 软链接读同一份，
# 测试（tests/conftest.py）从下面的 URL 推导。改端口只改本文件。
#   ln -sf ../.env.local deploy/.env        # 让 compose 也读这份
#
# 端口为何上移：3306/6379 已被同机 CubeSandbox 的 MySQL/Redis 占用，不挪会撞车。
# 若目标机 3306/6379 空闲，可整体改回默认 3306/6379（三处 URL 同步改即可）。

# ---- 基础设施端口（供 compose 端口映射；须与下方 URL 里的端口一致）----
PI_MYSQL_PORT=13306
PI_REDIS_PORT=16379
PI_MILVUS_PORT=19531

# ---- 数据库：本地栈 MySQL ----
PI_DATABASE_URL=mysql+aiomysql://pi:pi_py_local@127.0.0.1:13306/pi_py

# ---- 缓存/锁：本地栈 Redis ----
PI_REDIS_URL=redis://127.0.0.1:16379/0
PI_REDIS_NS=pi-local

# ---- 向量库：本地栈 Milvus standalone ----
PI_MILVUS_URI=http://127.0.0.1:19531

# ---- 模型与 embedding：云 API（本机无 GPU，与生产共用同一云服务）----
PI_MODEL=<填生产 .env 里的值>
OPENAI_API_KEY=<填生产 .env 里的值>
OPENAI_BASE_URL=<填生产 .env 里的值>
# embedding 走 OpenAI 兼容端点（/compatible-mode/v1/embeddings），只认这一种形状
PI_EMBEDDING_URL=<填生产 .env 里的值>
PI_EMBEDDING_API_KEY=<填生产 .env 里的值>
PI_EMBEDDING_MODEL=<填生产 .env 里的值>

# ---- RAG（企业知识库）----
# embedding / Milvus 不单独配：RAG 继承上面的 PI_EMBEDDING_* 与 PI_MILVUS_URI。
# 端点形态已统一为 OpenAI 兼容，无 PI_RAG_EMBED_STYLE。
#
# rerank：不开 recall@5 约 0.72，开了约 0.895。cross-encoder 是检索质量的关键。
PI_RAG_RERANK_URL=<填 rerank 端点>
PI_RAG_RERANK_API_KEY=<填 rerank key>
PI_RAG_RERANK_MODEL=<填 rerank 模型名>

# 重解析服务（复杂 PDF/扫描件/图片的 layout 解析，RAGFlow DeepDoc 思路）：
# paddleocr=接 PaddleOCR 线上 API；MinerU 服务就绪后改这三行即可迁移，
# 内核只依赖"文件 → Markdown"一个协议，输出经 vendor 中立清洗（clean_ocr_markdown）。
PI_RAG_HEAVY_PARSER=paddleocr
PI_RAG_HEAVY_PARSER_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PI_RAG_HEAVY_PARSER_TOKEN=<填 PaddleOCR token>
PI_RAG_HEAVY_PARSER_MODEL=PaddleOCR-VL-1.6

# ---- 对象存储：文件管线（MinIO）----
# 配齐三项后 /v1/files 上传/下载/预签名 URL 生效；未配时上传端点 503。
# 本地 MinIO 容器（docker-compose 或单独 pi-minio）默认 19000 端口。
PI_S3_ENDPOINT=http://127.0.0.1:19000
PI_S3_ACCESS_KEY=pi_minio
PI_S3_SECRET_KEY=<填 MinIO 密码>
PI_S3_BUCKET_FILES=pi-files

# ---- 安全/审计/轨迹 ----
PI_JWT_SECRET=<填一个随机长串，生产与本地不能共用>
# policy.json 是 git 追踪的安全规则（deny 命令模式），随仓库走，路径跟项目根。
# 这一处是唯一"项目根相关"的路径，和 systemd 的 WorkingDirectory 一起在迁移时改。
PI_POLICY=<项目根>/policy.json
# workspace/audit/trajectory 不设：代码默认落在 ~/.pi-py/ 下（home 相关，迁移零改动）。
# 不要写死成仓库目录——会与代码默认 base 分叉（历史教训：数据曾在两处都有）。
# PI_WORKSPACE_ROOT=
# PI_AUDIT_PATH=
# PI_TRAJECTORY_PATH=

# ---- 沙箱：CubeSandbox microVM（当前服务器方案，单选、fail-closed）----
# PI_SANDBOX 只选一个后端，不做自动回退：平台不可用即失败，不静默退到隔离更弱
# 的 Docker 容器。目标机若无 CubeSandbox 平台，改 PI_SANDBOX=docker 并删掉 PI_CUBE_*。
PI_SANDBOX=cubesandbox
PI_SANDBOX_TEMPLATE=<填 CubeSandbox 模板 id>
PI_CUBE_API_URL=http://127.0.0.1:3000
PI_CUBE_API_KEY=<填 CubeSandbox API key>
PI_CUBE_DOMAIN=cube.app
# 平台自签 CA + 系统 CA 的合并包。必须合并：单放平台 CA 会让 SSL_CERT_FILE 覆盖掉
# 系统信任链，直接打断模型与 embedding 的 HTTPS 调用。迁移时重新合并生成。
# 这个 CA 也在 ~/.pi-py/ 下（与上面 workspace/audit/trajectory 同 base），迁移一并搬。
PI_SANDBOX_CA_FILE=<home 目录>/.pi-py/cube-ca-bundle.pem

# ---- 可观测 ----
PI_TRACER=jsonl
PI_METRICS=1
PI_METRICS_TOKEN=
